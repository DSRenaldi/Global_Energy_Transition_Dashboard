# Copy this file to .env and replace only the placeholder values.
# Never commit .env or real credentials.

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=replace_with_your_local_postgresql_password
PGDATABASE=energy_transition
PGMAINTENANCE_DATABASE=postgres

# Web server
PORT=3000
NODE_ENV=development
